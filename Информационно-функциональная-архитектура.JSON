    "qr_scanner": {
      "id": "qr_scanner",
      "title": "Сканирование QR",
      "description": "Переключатель вкладок для входа в клуб или сканирования кода на тренажере",
      "type": "utility"
    },
    "post_training_survey": {
      "id": "post_training_survey",
      "title": "Опрос после тренировки",
      "description": "После завершения тренировки приходит уведомление: как прошла тренировка? Оцените — пара вопросов, чтобы в следующий раз при планировании тренировки были предложены упражнения с корректировкой интенсивности или сложности на основе выводов о самочувствии участника.",
      "type": "survey",
      "triggers": [
        "После записи на индивидуальную тренировку",
        "После записи на групповую тренировку",
        "После аренды площадки"
      ]
    },
    "rating_details": {
      "id": "rating_details",
      "title": "Детали рейтинга",
      "description": "Информация за что были начислены баллы и сформирован рейтинг. Базируется в личном кабинете, на главном экране отображается в виде дашборда.",
      "type": "screen"
    }
