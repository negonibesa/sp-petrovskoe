{
  "appName": "Спортивная платформа",
  "description": "User flow мобильного приложения для спортивной платформы с функциями записи на тренировки, рейтингом, сообществами и личным кабинетом",
  "screens": {
    "welcome": {
      "id": "welcome",
      "title": "Приветственный экран",
      "type": "entry_point",
      "next": [
        "auth"
      ]
    },
    "auth": {
      "id": "auth",
      "title": "Вход / Регистрация по коду (SMS или email)",
      "type": "authentication",
      "next": [
        "role_selection"
      ]
    },
    "role_selection": {
      "id": "role_selection",
      "title": "Выбор роли",
      "description": "Клиент / Тренер (судейство — по запросу в настройках карточки соревнований)",
      "type": "decision",
      "conditions": [
        {
          "condition": "first_login",
          "label": "Первый вход",
          "next": "onboarding"
        },
        {
          "condition": "returning_user",
          "label": "Повторный вход",
          "next": "home"
        }
      ]
    },
    "onboarding": {
      "id": "onboarding",
      "title": "Онбординг",
      "type": "flow",
      "next": [
        "questionnaire"
      ]
    },
    "questionnaire": {
      "id": "questionnaire",
      "title": "Анкета",
      "description": "ФИО, возраст, ID, сообщество, контакт родителя или другого ответственного лица для несовершеннолетних",
      "type": "form",
      "next": [
        "home"
      ]
    },
    "home": {
      "id": "home",
      "title": "Главная",
      "type": "main_screen",
      "sections": [
        {
          "id": "activity_rating",
          "title": "Ваша активность и рейтинг по региону/друзьям",
          "actions": [
            {
              "action": "tap_rating",
              "description": "По тапу открывается информация за что были начислены баллы и сформирован рейтинг (базируется в личном кабинете, на главном экране — дашборд)",
              "next": "rating_details"
            }
          ]
        },
        {
          "id": "news_feed",
          "title": "Лента новостей",
          "features": [
            "Фильтр по тегам: события площадки, события друзей, события клубов"
          ],
          "actions": [
            {
              "action": "filter_news",
              "description": "Фильтр новостей по тегам",
              "next": "news_filter"
            },
            {
              "action": "go_to_event_from_news",
              "description": "Из новости можно перейти к мероприятию и записаться на него, после чего оно появится в календаре",
              "next": "event_signup"
            }
          ]
        },
        {
          "id": "upcoming_bookings",
          "title": "Карточка ваших ближайших записей/запланированных тренировок",
          "actions": [
            {
              "action": "go_to_calendar",
              "description": "Переход к календарю записей",
              "next": "booking_calendar"
            }
          ]
        },
        {
          "id": "club_events",
          "title": "Карточка ближайших событий в клубе",
          "actions": [
            {
              "action": "quick_signup",
              "description": "Быстрая запись прямо из карточки + информация кто из друзей записан",
              "next": "quick_booking"
            },
            {
              "action": "go_to_club_schedule",
              "description": "Переход к расписанию клуба",
              "next": "club_schedule"
            }
          ]
        },
        {
          "id": "communities",
          "title": "Список сообществ по интересам",
          "actions": [
            {
              "action": "view_community",
              "description": "Мероприятия и соревнования сообщества, кто из друзей состоит в сообществе",
              "next": "community_details"
            }
          ]
        }
      ],
      "navigation": [
        "schedule",
        "training_calendar",
        "notifications",
        "profile",
        "qr_scanner"
      ]
    },
    "notifications": {
      "id": "notifications",
      "title": "Уведомления",
      "type": "screen",
      "content": {
        "types": [
          "О начале тренировки",
          "О новой записи на тренировку",
          "Об отмене тренировки",
          "О новом большом событии (например соревнование, где участвует спортшкола)"
        ],
        "actions": [
          {
            "action": "delete_notification",
            "description": "Возможность удалить уведомление"
          }
        ]
      }
    },
    "schedule": {
      "id": "schedule",
      "title": "Расписание активностей и тренировок платформы",
      "type": "screen",
      "tabs": [
        {
          "id": "individual_training",
          "title": "Запись на индивидуальную тренировку",
          "flow": [
            {
              "step": "filter",
              "title": "Фильтр по типу тренировки и тренеру"
            },
            {
              "step": "trainer_card",
              "title": "Карточка тренера со слотами времени"
            },
            {
              "step": "booking",
              "title": "Запись / Отмена"
            }
          ]
        },
        {
          "id": "group_training",
          "title": "Запись на групповую тренировку или событие / отмена записи",
          "flow": [
            {
              "step": "filter",
              "title": "Фильтр по типу тренировки, тренеру, возрастной группе, сложности"
            },
            {
              "step": "booking",
              "title": "Запись / Отмена"
            }
          ]
        },
        {
          "id": "self_training",
          "title": "Самостоятельные тренировки"
        },
        {
          "id": "court_rental",
          "title": "Аренда корта/площадки/роликов/времени в зале",
          "flow": [
            {
              "step": "booking",
              "title": "Запись / Отмена"
            }
          ]
        }
      ]
    },
    "training_calendar": {
      "id": "training_calendar",
      "title": "Календарь запланированных тренировок",
      "type": "screen",
      "actions": [
        {
          "action": "tap_date",
          "description": "По клику на дату открывается карточка тренировки: информация о тренировке, информация о прибытии, информация о состоянии после тренировки (если пользователь заполнил опрос)",
          "next": "training_card_details"
        }
      ]
    },
    "booking_calendar": {
      "id": "booking_calendar",
      "title": "Календарь записей",
      "type": "screen",
      "actions": [
        {
          "action": "view_all_bookings",
          "title": "Просмотр всех записей",
          "next": "all_bookings_list"
        },
        {
          "action": "add_change_cancel",
          "title": "Добавить / Отменить / Изменить запись"
        }
      ]
    },
    "all_bookings_list": {
      "id": "all_bookings_list",
      "title": "Просмотр всех записей в строчном режиме",
      "description": "Видно запись и статус: посетил / не прибыл",
      "type": "screen",
      "next": [
        "training_constructor"
      ]
    },
    "training_constructor": {
      "id": "training_constructor",
      "title": "Конструктор тренировки",
      "description": "Можно сформировать тренировку самостоятельно и добавить её в календарь. Для ГТО — отдельная заготовка из упражнений для подготовки к сдаче.",
      "type": "screen",
      "features": [
        "Формирование произвольной тренировки",
        "Добавление в календарь",
        "Заготовка упражнений для ГТО",
        "Рекомендации на основе предыдущих опросов о самочувствии"
      ],
      "actions": [
        {
          "action": "add_change_cancel",
          "title": "Добавить / Отменить / Изменить"
        }
      ]
    },
    "club_schedule": {
      "id": "club_schedule",
      "title": "Расписание клуба",
      "type": "screen",
      "tabs": [
        "Самостоятельные тренировки",
        "Групповые",
        "Индивидуальные",
        "Аренда корта/площадки"
      ],
      "actions": [
        {
          "action": "book_training",
          "description": "Запись на тренировку или аренду площадки, выбор свободного слота времени. Возможность отмены записи, возможность поделиться ссылкой на тренировку.",
          "next": "booking_confirmation"
        }
      ]
    },
    "profile": {
      "id": "profile",
      "title": "Личный кабинет",
      "type": "screen",
      "sections": [
        {
          "id": "personal_data",
